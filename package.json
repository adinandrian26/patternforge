{
  "name": "patternforge",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop foundation for PatternForge",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @patternforge/desktop",
    "build": "npm run build --workspace @patternforge/desktop",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri:dev": "npm run tauri:dev --workspace @patternforge/desktop",
    "tauri:build": "npm run tauri:build --workspace @patternforge/desktop"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
